# Citadel Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/citadel?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/citadel_vault

# JWT Secret Key for Session Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# 32-byte hexadecimal encryption key for AES-256-GCM (64 hex characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=e7b4f58c93a129d84e567f12bc098d34fa129845ecbd7890123456789abcdef0

# Allowed Frontend Origin for CORS (e.g., https://your-citadel-app.vercel.app or http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Document Storage Provider: 'local' (default) or 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads/documents
