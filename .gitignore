# Dependencies
node_modules/
*/node_modules/

# Environment Variables & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# Build Output
dist/
build/
frontend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Uploaded Documents & Avatars (preserves .gitkeep so directories exist on clone)
/backend/uploads/documents/*
!/backend/uploads/documents/.gitkeep
/backend/uploads/avatars/*
!/backend/uploads/avatars/.gitkeep

# OS Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
